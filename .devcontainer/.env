# gunicorn (see runtime/bin/cmd.sh for default values)
GUNICORN_NUM_WORKERS=1
GUNICORN_TIMEOUT=3600

# service
LISTEN_IP=0.0.0.0
LISTEN_PORT=80

# otel
OTEL_TRACE_ENABLED=false

# db
SQLDB_ENGINE_OPTIONS={"pool_pre_ping": true, "pool_size": 10, "pool_recycle": 120}
SQLDB_DBNAME=yag
SQLDB_HOST=sqldb.yag.dc
SQLDB_PORT=5432
SQLDB_USERNAME=authsvc

# app
ACCOUNTSVC_URL=http://accountsvc.yag.dc:8091
APPSVC_URL=http://appsvc.yag.dc:8085
BEHIND_PROXY=true
JUKEBOXSVC_URL=http://jukeboxsvc.yag.dc:8083
SESSIONSVC_URL=http://sessionsvc.yag.dc:8084
